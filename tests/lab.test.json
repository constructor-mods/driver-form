{
  "schema": 1,
  "suite": "msyeett.driver-form",
  "defaults": {
    "timeout_s": 900,
    "settings": {
      "msyeett.driver-form": {
        "form_strength": "normal",
        "form_board": true,
        "messages_race": "ultra"
      }
    }
  },
  "tests": [
    {
      "id": "perf",
      "env": {
        "kind": "benchmark",
        "track": "bahrain",
        "laps": 10,
        "cars": 22,
        "weather": "clear"
      },
      "steps": [
        {
          "wait": {
            "log": "driver-form\\] board"
          },
          "timeout_s": 500
        },
        {
          "wait": {
            "log": "driver-form\\] session.end"
          },
          "timeout_s": 700
        }
      ],
      "assert": [
        {
          "log": "driver-form\\] \\S+ moment for"
        },
        {
          "no_crash": true
        }
      ]
    }
  ]
}